# ---------------------------------------------------------------------------
# Carolina Academy — Environment Variables
# Copy this file to .env.local and fill in real values before deploying.
# Never commit .env.local. Never expose secret keys with a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://carolinaacademy.lk

# Analytics & tracking (client-side, safe to expose)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Enquiry delivery over SMTP (Zoho Mail) — server-side only, never NEXT_PUBLIC_.
# Zoho paid/organisation accounts use smtppro.zoho.com; free accounts use smtp.zoho.com.
# Use a dedicated sender mailbox and a Zoho app-specific password (not the main password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: From address (must be the SMTP_USER mailbox or one of its Zoho aliases). Defaults to SMTP_USER.
SMTP_FROM=
# Mailbox that receives website enquiries (required)
ADMIN_NOTIFICATION_EMAIL=
# Optional: mailbox for separate "[Marketing opt-in]" consent records. Defaults to ADMIN_NOTIFICATION_EMAIL.
MARKETING_CONSENT_LOG_EMAIL=

# CRM / webhook / spreadsheet integrations (server-side only)
CRM_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp (public — used to build wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER=94716373334

# Maps — one embed URL per location ("Embed a map" share link from Google Maps)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL_CHILAW=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL_KATUNAYAKE=

# Anti-spam / rate limiting (server-side only, optional)
FORM_RATE_LIMIT_WINDOW_MS=60000
FORM_RATE_LIMIT_MAX_SUBMISSIONS=5
