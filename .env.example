# ---------------------------------------------------------------------------
# Carolina Academy — Environment Variables
# Copy this file to .env.local and fill in real values before deploying.
# Never commit .env.local. Never expose secret keys with a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://carolinaacademy.lk

# Analytics & tracking (client-side, safe to expose)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact / lead routing
CONTACT_EMAIL=info@carolinaacademy.lk
ADMIN_NOTIFICATION_EMAIL=info@carolinaacademy.lk

# Email provider (server-side only — pick ONE and implement in lib/email.ts)
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=

# CRM / webhook / spreadsheet integrations (server-side only)
CRM_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp (public — used to build wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER=94773952316

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Anti-spam / rate limiting (server-side only, optional)
FORM_RATE_LIMIT_WINDOW_MS=60000
FORM_RATE_LIMIT_MAX_SUBMISSIONS=5
